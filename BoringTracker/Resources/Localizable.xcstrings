    "Add Tracker": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un suivi"
          }
        }
      }
    },
    "Add one to start counting whatever you like.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un suivi pour commencer à compter ce que vous voulez."
          }
        }
      }
    },
    "Added %@ and %@.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajout : %@ et %@."
          }
