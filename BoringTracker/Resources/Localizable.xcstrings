      }
    },
    "Drag onto another tracker": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur un autre suivi"
          }
        }
      }
    },
    "Each entry is a reading on its own. Nothing resets.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque entrée est une mesure indépendante. Rien n’est remis à zéro."
          }
        }
      }
    },
