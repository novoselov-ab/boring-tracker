    "Hidden from the home screen. Nothing logged against them is lost.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masqués sur l’écran d’accueil. Leur historique est conservé."
          }
        }
      }
