{
  "sourceLanguage": "en",
  "strings": {
    " A backup of the previous document was kept on this device.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Une sauvegarde du document précédent a été conservée sur cet appareil."
          }
        }
      }
    },
    " Nothing was changed.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Aucune modification n’a été effectuée."
          }
        }
      }
    },
    " Restore Previous Data brings it back.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " L’option « Restaurer les données précédentes » permet de les récupérer."
          }
        }
      }
    },
    "%@ Between groups, its whole group moves with it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Entre les groupes, tout son groupe se déplace avec lui."
          }
        }
      }
    },
    "%@ The document you replaced is now the recoverable backup.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Le document remplacé est maintenant la sauvegarde récupérable."
          }
        }
      }
    },
    "%@ a day on %lld logged days": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par jour sur %lld jours renseignés"
          }
        }
      }
    },
    "%@ to %@": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De %@ à %@"
