    "Choose what you want to track. You can change all of it later.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce que vous voulez suivre. Vous pourrez tout modifier ensuite."
