      }
    },
    "All": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout"
          }
        }
      }
    },
    "Anything you log to a daily total turns up here, named or not, to log again in one tap. A measurement like weight does not: you would take a new reading rather than repeat the last one.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous ajoutez à un total quotidien apparaît ici, avec ou sans nom, pour l’ajouter à nouveau en un geste. Les mesures comme le poids n’y figurent pas : il faut prendre une nouvelle mesure."
          }
        }
      }
    },
    "Appearance": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparence"
          }
        }
      }
    },
    "Archive": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiver"
